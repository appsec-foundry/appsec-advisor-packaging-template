#!/usr/bin/python3
"""`python3` stub for testing package-local.sh.

NOTE: shebang must be the REAL interpreter, not `/usr/bin/env python3` — this
stub is first on PATH as `python3`, so an env-based shebang would re-resolve to
this same file and loop forever.

Intercepts the upstream packaging/smoke scripts so no real upstream is needed.
  PYSTUB_FAIL=package   -> package_internal_plugin.py exits non-zero
  PYSTUB_FAIL=smoke     -> smoke_test_package.py exits non-zero
  PYSTUB_FAIL=baseline  -> resolve-baseline-id.py exits non-zero
  PYSTUB_BASELINE_ID=…  -> id that resolve-baseline-id.py prints
Anything else is delegated to the real python3 so normal use is unaffected.
"""

import os
import sys
import json
import shutil

args = sys.argv[1:]
script = args[0] if args else ""
fail = os.environ.get("PYSTUB_FAIL", "")

if args[:1] == ["-c"]:
    source = args[1] if len(args) > 1 else ""
    if os.environ.get("PYSTUB_PYTHON_TOO_OLD") == "1" and "sys.version_info" in source:
        sys.exit(1)
    if os.environ.get("PYSTUB_MISSING_BUILD_MODULES") and "importlib.util" in source:
        print(os.environ["PYSTUB_MISSING_BUILD_MODULES"])
        sys.exit(0)

if script.endswith("resolve-baseline-id.py"):
    if fail == "baseline":
        sys.stderr.write("ERROR: cannot fetch the baseline source\n")
        sys.exit(2)
    print(os.environ.get("PYSTUB_BASELINE_ID", "aiscb-0.1.10"))
    sys.exit(0)

if script.endswith("package_internal_plugin.py"):
    # Create the expected build output dir so a following smoke step has a target.
    name = None
    source = None
    version = None
    org_profile = None
    info_url = None
    for i, a in enumerate(args):
        if a == "--name" and i + 1 < len(args):
            name = args[i + 1]
        if a == "--source" and i + 1 < len(args):
            source = args[i + 1]
        if a == "--version" and i + 1 < len(args):
            version = args[i + 1]
        if a == "--org-profile" and i + 1 < len(args):
            org_profile = args[i + 1]
        if a == "--info-url" and i + 1 < len(args):
            info_url = args[i + 1]
    expected_skill = os.environ.get("PYSTUB_EXPECT_SOURCE_SKILL", "")
    if expected_skill:
        skill_md = os.path.join(source or "", "skills", expected_skill, "SKILL.md")
        if not os.path.isfile(skill_md):
            print(f"expected source skill not found: {skill_md}", file=sys.stderr)
            sys.exit(5)
    # The resolved policy the packager is handed decides which optional skills
    # this build ships; assert on it rather than on the untouched source policy.
    policy_path = None
    for i, a in enumerate(args):
        if a == "--package-policy" and i + 1 < len(args):
            policy_path = args[i + 1]
    policy_text = ""
    if policy_path and os.path.isfile(policy_path):
        with open(policy_path, encoding="utf-8") as file:
            policy_text = file.read()
    wanted = os.environ.get("PYSTUB_EXPECT_POLICY_SKILL", "")
    if wanted and wanted not in policy_text:
        print(f"expected skill in resolved policy: {wanted}", file=sys.stderr)
        sys.exit(6)
    unwanted = os.environ.get("PYSTUB_REJECT_POLICY_SKILL", "")
    if unwanted and unwanted in policy_text:
        print(f"unexpected skill in resolved policy: {unwanted}", file=sys.stderr)
        sys.exit(6)
    if name:
        root = os.path.join("build", name)
        metadata = os.path.join(root, ".claude-plugin")
        os.makedirs(metadata, exist_ok=True)
        shutil.copytree(os.path.join(source or "", "scripts"), os.path.join(root, "scripts"))
        if org_profile:
            shutil.copytree(org_profile, os.path.join(root, "org-profile"))
        with open(os.path.join(metadata, "plugin.json"), "w", encoding="utf-8") as file:
            json.dump({"name": name, "version": version or "0.0.0-test.1"}, file)
        with open(
            os.path.join(metadata, "package-surface.json"), "w", encoding="utf-8"
        ) as file:
            json.dump(
                {
                    "version": 1,
                    "skills": {
                        "included": ["create-threat-model", "help"],
                        "removed": ["publish-threat-model"],
                    },
                    "hooks": {"included": ["session-banner"], "removed": []},
                    "upstream_url": "https://github.com/appsec-foundry/appsec-advisor.git",
                },
                file,
            )
        baseline = {
            "enabled": True,
            "id": "aisec-0.1",
            "name": "AI Secure Coding Baseline",
            "url": (
                "https://raw.githubusercontent.com/matthiasrohr/"
                "ai-secure-coding-baseline/main/secure-coding-baseline.md"
            ),
        }
        profile_path = os.path.join(org_profile or "", "org-profile.yaml")
        if os.path.isfile(profile_path):
            import yaml

            with open(profile_path, encoding="utf-8") as file:
                profile = yaml.safe_load(file) or {}
            override = profile.get("baseline")
            if isinstance(override, dict):
                if any(key in override for key in ("id", "url", "git", "file")):
                    baseline.pop("url", None)
                    baseline.pop("name", None)
                for key in ("enabled", "id", "name", "url"):
                    if key in override:
                        baseline[key] = override[key]
        with open(os.path.join(root, "config.json"), "w", encoding="utf-8") as file:
            json.dump(
                {
                    "skill_toggles": {},
                    "banner": {
                        "enabled": True,
                        "url": info_url or None,
                    },
                    "baseline": baseline,
                },
                file,
            )
        for skill, description in (
            ("create-threat-model", "Create a threat model."),
            ("help", "Show generic upstream help."),
        ):
            skill_dir = os.path.join(root, "skills", skill)
            os.makedirs(skill_dir, exist_ok=True)
            with open(
                os.path.join(skill_dir, "SKILL.md"), "w", encoding="utf-8"
            ) as file:
                file.write(
                    f"---\nname: {skill}\ndescription: {description}\n---\n\nStub.\n"
                )
    sys.exit(3 if fail == "package" else 0)

if script.endswith("smoke_test_package.py"):
    sys.exit(4 if fail == "smoke" else 0)

# Delegate everything else to the real interpreter.
real = "/usr/bin/python3"
os.execv(real, [real, *args])
