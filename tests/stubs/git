#!/usr/bin/python3
"""Configurable `git` stub for testing fetch-upstream.sh offline.

Behavior is driven by env vars so each scenario can simulate a different
upstream state without any network:

  GITSTUB_IS_CHECKOUT=1   `rev-parse --git-dir` succeeds (DEST is a checkout)
  GITSTUB_HAS_ORIGIN=1    `remote get-url origin` succeeds
  GITSTUB_TAGS="v0.3.0 v0.4.0"   tags that exist upstream
  GITSTUB_HEADS="main dev"       branches that exist upstream
  GITSTUB_LOCAL_SHA=abc1234      `rev-parse HEAD` of the local checkout
  GITSTUB_COMMIT_DATE=…          `show -s --format=%cI` of that commit
  GITSTUB_REMOTE_SHA=abc1234     sha for a bare `ls-remote <url> <ref>`
  GITSTUB_TAG_COMMIT_SHA=…       commit an annotated tag peels to; set it to
                                 make the tag annotated, with GITSTUB_REMOTE_SHA
                                 as the tag object's own sha
  GITSTUB_TAG_MOVED=1            the upstream tag points at a new commit: like
                                 real git, a tag fetch without --force is
                                 rejected, and the local tag only changes once
                                 a forced fetch has run
"""
import os
import sys

argv = sys.argv[1:]
# Strip leading `-C <dir>`.
if argv[:1] == ["-C"]:
    argv = argv[2:]
sub = argv[0] if argv else ""
rest = argv[1:]

TAGS = os.environ.get("GITSTUB_TAGS", "").split()
HEADS = os.environ.get("GITSTUB_HEADS", "").split()
SHA = "abc1234"
TEMPLATE_SHA = os.environ.get("GITSTUB_TEMPLATE_SHA", "a" * 40)


def out(s=""):
    if s:
        sys.stdout.write(s + "\n")


def has(flag):
    return flag in rest


def last():
    return rest[-1] if rest else ""


MOVED_MARKER = ".git/tag-force-fetched"


def tag_moved():
    return os.environ.get("GITSTUB_TAG_MOVED") == "1"


if sub == "rev-parse":
    if "--git-dir" in rest:
        sys.exit(0 if os.environ.get("GITSTUB_IS_CHECKOUT") == "1" else 1)
    if "--verify" in rest and any(a.startswith("refs/tags/") for a in rest):
        if not tag_moved():
            out(SHA)
        elif os.path.isfile(MOVED_MARKER):
            out("def5678")
        else:
            out("old0000")
        sys.exit(0)
    if "--short" in rest:
        out(SHA)
        sys.exit(0)
    if "--verify" in rest and "HEAD^{commit}" in rest:
        out(TEMPLATE_SHA)
        sys.exit(0)
    # plain `rev-parse HEAD` -> local checkout commit
    out(os.environ.get("GITSTUB_LOCAL_SHA", SHA))
    sys.exit(0)

if sub == "show" and "--format=%cI" in rest:
    out(os.environ.get("GITSTUB_COMMIT_DATE", "2026-08-23T19:09:53+02:00"))
    sys.exit(0)

if sub == "var" and rest == ["GIT_AUTHOR_IDENT"]:
    if os.environ.get("GITSTUB_IDENTITY_MISSING") == "1":
        sys.exit(1)
    out("Test User <test@example.test> 0 +0000")
    sys.exit(0)

if sub == "diff" and rest == ["--cached", "--quiet"]:
    sys.exit(1 if os.environ.get("GITSTUB_HAS_STAGED_CHANGES") == "1" else 0)

if sub == "diff" and "--quiet" in rest:
    sys.exit(1 if os.environ.get("GITSTUB_TEMPLATE_DIRTY") == "1" else 0)

if sub == "ls-files":
    if os.environ.get("GITSTUB_TEMPLATE_UNTRACKED") == "1":
        out("untracked-template-file")
    sys.exit(0)

if sub == "show-ref":
    ref = last().split("refs/tags/")[-1]
    sys.exit(0 if ref in TAGS else 1)

if sub == "commit":
    sys.exit(1 if os.environ.get("GITSTUB_FAIL_COMMIT") == "1" else 0)

if sub == "clone":
    # Last positional is the destination; create it so later checks find a dir.
    dest = rest[-1]
    src = os.environ.get("GITSTUB_CLONE_SRC")
    if src:
        import shutil
        shutil.copytree(src, dest, dirs_exist_ok=True,
                        ignore=shutil.ignore_patterns(".git", "build", "dist",
                                                       "upstream", "tests"))
    else:
        os.makedirs(dest, exist_ok=True)
    sys.exit(0)

if sub == "init":
    os.makedirs(".git", exist_ok=True)
    sys.exit(0)

if sub == "remote":
    if rest[:1] == ["get-url"]:
        marker = os.path.join(".git", "remote-origin")
        if os.path.isfile(marker):
            with open(marker, encoding="utf-8") as file:
                out(file.read().strip())
            sys.exit(0)
        if os.environ.get("GITSTUB_HAS_ORIGIN") == "1":
            out("https://github.com/appsec-foundry/appsec-advisor.git")
            sys.exit(0)
        sys.stderr.write("error: No such remote 'origin'\n")
        sys.exit(2)
    if rest[:1] == ["add"] and len(rest) >= 3 and rest[1] == "origin":
        os.makedirs(".git", exist_ok=True)
        with open(os.path.join(".git", "remote-origin"), "w", encoding="utf-8") as file:
            file.write(rest[2] + "\n")
        sys.exit(0)
    # set-url
    sys.exit(0)

if sub == "ls-remote":
    if os.environ.get("GITSTUB_FAIL_LS_REMOTE") == "1":
        sys.exit(2)
    arg = last()
    if arg == "HEAD":
        remote_sha = os.environ.get("GITSTUB_REMOTE_SHA", TEMPLATE_SHA)
        out(f"{remote_sha}\tHEAD")
        sys.exit(0)
    if has("--exit-code"):
        if has("--tags"):
            ref = arg.split("refs/tags/")[-1]
            sys.exit(0 if ref in TAGS else 2)
        if has("--heads"):
            ref = arg.split("refs/heads/")[-1]
            sys.exit(0 if ref in HEADS else 2)
        sys.exit(2)
    if has("--tags") and arg.startswith("refs/tags/"):
        ref = arg.split("refs/tags/")[-1]
        if ref in TAGS:
            out(f"{SHA}\trefs/tags/{ref}")
        sys.exit(0)
    if has("--heads") and arg.startswith("refs/heads/"):
        ref = arg.split("refs/heads/")[-1]
        if ref in HEADS:
            out(f"{TEMPLATE_SHA}\trefs/heads/{ref}")
        sys.exit(0)
    if has("--tags"):  # listing form: ls-remote --tags --refs origin 'v[0-9]*'
        for t in TAGS:
            out(f"{SHA}\trefs/tags/{t}")
        sys.exit(0)
    # bare ref form: ls-remote <url> <ref> [<ref>^{}]
    remote_sha = os.environ.get("GITSTUB_REMOTE_SHA", SHA)
    # An annotated tag has a second `<commit> refs/tags/<t>^{}` line; the ref
    # line then carries the tag object's own sha, not the commit's.
    tag_commit = os.environ.get("GITSTUB_TAG_COMMIT_SHA", "")
    for pattern in (rest[1:] or [arg]):
        name = pattern.rsplit("/", 1)[-1]
        peeled = name.endswith("^{}")
        base = name[:-3] if peeled else name
        if base in TAGS:
            if not peeled:
                out(f"{remote_sha}\trefs/tags/{base}")
            elif tag_commit:
                out(f"{tag_commit}\trefs/tags/{base}^{{}}")
        elif base in HEADS and not peeled:
            out(f"{remote_sha}\trefs/heads/{base}")
    sys.exit(0)

if sub == "fetch":
    if os.environ.get("GITSTUB_FAIL_FETCH") == "1":
        sys.exit(1)
    if tag_moved() and any(a.startswith("refs/tags/") for a in rest):
        if not has("--force"):
            sys.stderr.write(
                f" ! [rejected]        {last()}  (would clobber existing tag)\n"
            )
            sys.exit(1)
        os.makedirs(".git", exist_ok=True)
        open(MOVED_MARKER, "w", encoding="utf-8").close()
    sys.exit(0)

if sub == "checkout":
    sys.exit(0)

sys.exit(0)
